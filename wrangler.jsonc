{
  "name": "serverless-dns2",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  // Requests share promises on purpose (src/upstream.ts coalesce, src/loaded.ts):
  // without this flag a request whose client went away strands the others
  // waiting on its promise, and the runtime cancels them as "hung".
  "compatibility_flags": ["no_handle_cross_request_promise_resolution"],
  "workers_dev": false,
  "preview_urls": false,
  // Workers Logs keeps what src/log.ts writes (failures and slow answers), not a line per request.
  "observability": {
    "enabled": true,
    "logs": {"invocation_logs": false},
  },
}
