{
  "name": "serverless-dns2",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  // Workers Logs keeps what src/log.ts writes (failures and slow answers), not a line per request.
  "observability": {
    "enabled": true,
    "logs": {"invocation_logs": false},
  },
}
