{
  "name": "serverless-dns2",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && tsc --noEmit -p scripts && tsc --noEmit -p test",
    "format": "prettier --write src",
    "deploy": "bun run build-lists && wrangler deploy",
    "build-lists": "bun scripts/build-blocklist.ts",
    "test": "bun test --timeout 60000"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "@types/node": "^26.6.6",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.166.0"
  }
}
